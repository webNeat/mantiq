{
  "name": "mantiq",
  "author": "Amine Ben hammou (@webNeat)",
  "description": "Write AI prompts in Typescript",
  "keywords": [
    "ai",
    "agent",
    "prompt",
    "typescript",
    "llm",
    "workflow",
    "skills",
    "cli",
    "automation",
    "claude-code",
    "codex",
    "copilot",
    "cursor",
    "opencode",
    "windsurf"
  ],
  "license": "MIT",
  "version": "0.0.1",
  "repository": "webNeat/mantiq",
  "homepage": "https://github.com/webNeat/mantiq",
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "bin": {
    "mantiq": "./bin/mantiq"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "files"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "pretest": "pnpm build",
    "test": "MANTIQ_CONFIG_PATH=tests/mantiq.json vitest run",
    "test-watch": "MANTIQ_CONFIG_PATH=tests/mantiq.json vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "release": "pnpm build && changeset publish",
    "version": "changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^25.9.0",
    "dedent": "^1.7.2",
    "expect-type": "^1.3.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "typescript": "^6.0.3"
  }
}
